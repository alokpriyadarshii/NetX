[Unit]
Description=NetX - A light-weight DNS-to-HTTPS, non-caching translation service
Requires=network.target
Wants=nss-lookup.target
Before=nss-lookup.target
After=network.target

[Service]
Type=${SERVICE_TYPE}
DynamicUser=yes
ExecStart=${CMAKE_INSTALL_PREFIX}/${CMAKE_INSTALL_BINDIR}/NetX \
  -v -v ${SERVICE_EXTRA_OPTIONS}
Restart=on-failure
RestartSec=5
TimeoutStartSec=20
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
